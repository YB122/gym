# ---------------------------------------------------------------------------
# FORGE platform — local environment template
# Copy to `.env` at the repo root:  Copy-Item .env.example .env
# The backend loads this file; the frontend scripts pass it to Next.js.
# Never commit `.env`. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Runtime
PORT=4000
APP_VERSION=0.1.0
LOG_LEVEL=debug

# URLs — local web and API are same-site (localhost), so cookies work.
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Database (Docker single-node replica set; transactions require this)
MONGODB_URI=mongodb://localhost:27017/gym

# Web (frontend scripts load this root file with dotenv-cli)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Phase 1+ — placeholders only. Fill in when the relevant phase starts.
# Generate a real auth secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=dev-only-change-me-00000000000000000000000000000000
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test mode (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/account/membership?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/membership?checkout=cancelled

# Email — Mailpit locally (SMTP 1025, UI 8025); Resend in deployed envs.
RESEND_API_KEY=
EMAIL_FROM=FORGE <train@forge.local>
SMTP_HOST=localhost
SMTP_PORT=1025

# First superadmin seed (Phase 1). Change before running against any shared DB.
SUPERADMIN_EMAIL=owner@forge.local
SUPERADMIN_TEMP_PASSWORD=ChangeMe!12345

# Observability (Phase 5)
SENTRY_DSN=
